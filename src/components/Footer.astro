---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer__top">
    <div>
      <a href="/" class="footer__brand" aria-label="BMS Carz home">
        <Logo class="footer__logo" />
      </a>
      <div class="footer__addr">Shop C3, Shah Arcade, Sector 6, Kharghar · Open daily, 8am–8pm</div>
    </div>
    <nav class="footer__nav" aria-label="Footer">
      <a href="/collection/">Collection</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="footer__legal">
    <span>© {new Date().getFullYear()} BMS Carz</span>
  </div>
</footer>

<style>
  .footer { padding: 80px var(--gutter) 40px; border-top: 1px solid rgba(244, 245, 247, .08); }
  .footer__top { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .footer__brand { display: block; color: var(--ink); line-height: 0; }
  .footer__brand:hover { color: var(--ink); }
  .footer__brand :global(.footer__logo) { display: block; height: 84px; width: auto; }
  .footer__addr { margin-top: 12px; font-size: 13px; font-weight: 300; color: rgba(244, 245, 247, .5); }
  .footer__nav { display: flex; gap: 32px; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
  .footer__nav a { color: rgba(244, 245, 247, .6); transition: color .4s; }
  .footer__nav a:hover { color: var(--ink); }
  .footer__legal {
    margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(244, 245, 247, .06);
    display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: rgba(244, 245, 247, .36);
  }
  .footer__legal a { color: inherit; transition: color .4s; }
  .footer__legal a:hover { color: var(--ink); }
</style>
