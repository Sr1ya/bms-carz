---
import Base from '../layouts/Base.astro';
import CarCard from '../components/CarCard.astro';
import { CARS, CATEGORIES } from '../data/cars';

// Sorting by price only makes sense once prices are filled in.
const priced = CARS.some((c) => c.price !== undefined);
---

<Base title="The collection">
  <section class="page">
    <div class="eyebrow" data-reveal>The collection</div>
    <div class="head">
      <h1 class="page-title head__title" data-reveal><span id="count">{CARS.length}</span> cars, <span class="it">hand-picked.</span></h1>
      {priced && <button type="button" class="sort" id="sort" data-reveal>Sort — <span id="sort-label">Featured</span></button>}
    </div>
    <div class="filters" role="group" aria-label="Filter by category">
      {CATEGORIES.map((label, i) => (
        <button type="button" class="filter" data-filter={label} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>
      ))}
    </div>
    <div class="grid" id="grid">
      {CARS.map((car, i) => <CarCard car={car} index={i} />)}
    </div>
  </section>
</Base>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-top: 20px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .head__title { margin: 0; }
  .sort, .filter { background: none; border: 0; padding: 0; font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; cursor: pointer; }
  .sort { color: rgba(244, 245, 247,.7); transition: color .4s; }
  .sort:hover { color: var(--ink); }
  .filters { display: flex; gap: 36px; flex-wrap: wrap; margin-top: 28px; }
  .filter {
    padding: 8px 0; letter-spacing: .26em; color: rgba(244, 245, 247,.5);
    border-bottom: 1px solid transparent; transition: color .4s, border-color .4s;
  }
  .filter:hover { color: var(--ink); }
  .filter[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--accent); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 64px clamp(20px, 2.4vw, 36px); margin-top: 56px; }
  @media (max-width: 600px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px 12px; margin-top: 32px; }
    .filters { gap: 22px; }
    .head { padding-bottom: 24px; }
  }
</style>

<script>
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-cat]')];
  const count = document.getElementById('count')!;
  const sortBtn = document.getElementById('sort');
  const sortLabel = document.getElementById('sort-label');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  const SORTS = ['featured', 'low', 'high'] as const;
  const LABELS = { featured: 'Featured', low: 'Price, low to high', high: 'Price, high to low' };
  let sort: (typeof SORTS)[number] = 'featured';
  let filter = 'All';

  function render() {
    const num = (el: HTMLElement, k: string) => Number(el.dataset[k]);
    // Cars without a price sort last either way.
    const price = (el: HTMLElement, missing: number) => (el.dataset.price ? Number(el.dataset.price) : missing);
    const sorted = [...cards].sort((a, b) =>
      sort === 'low' ? price(a, Infinity) - price(b, Infinity)
      : sort === 'high' ? price(b, -Infinity) - price(a, -Infinity)
      : num(a, 'order') - num(b, 'order'));
    let shown = 0;
    sorted.forEach((card) => {
      const visible = filter === 'All' || card.dataset.cat === filter;
      card.hidden = !visible;
      if (visible) card.style.transitionDelay = `${((shown++ % 3) * 0.12).toFixed(2)}s`;
      grid.appendChild(card);
    });
    count.textContent = String(shown);
    if (sortLabel) sortLabel.textContent = LABELS[sort];
    filters.forEach((f) => f.setAttribute('aria-pressed', String(f.dataset.filter === filter)));
    window.dispatchEvent(new Event('bms:rescan'));
  }

  sortBtn?.addEventListener('click', () => {
    sort = SORTS[(SORTS.indexOf(sort) + 1) % SORTS.length];
    render();
  });
  filters.forEach((f) => f.addEventListener('click', () => { filter = f.dataset.filter!; render(); }));
</script>
