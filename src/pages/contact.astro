---
import Base from '../layouts/Base.astro';

const DIRECTIONS = 'https://www.google.com/maps/dir/?api=1&destination=' +
  encodeURIComponent('BMS Carz, Shah Arcade, Sector 6, Kharghar, Navi Mumbai 410210');
---

<Base title="Contact">
  <section class="page">
    <div class="eyebrow" data-reveal>Contact</div>
    <h1 class="page-title">
      <span class="mask"><span data-line data-hero-reveal>Arrange a <span class="it">private viewing.</span></span></span>
    </h1>
    <div class="grid">
      <form class="form" data-reveal data-inline-form>
        <label class="sr-only" for="c-name">Your name</label>
        <input id="c-name" name="name" class="field" placeholder="Your name" autocomplete="name" required />
        <label class="sr-only" for="c-phone">Phone</label>
        <input id="c-phone" name="phone" type="tel" class="field" placeholder="Phone" autocomplete="tel" required />
        <label class="sr-only" for="c-note">Which car, and when suits you?</label>
        <textarea id="c-note" name="note" rows="3" class="field" placeholder="Which car, and when suits you?"></textarea>
        <button type="submit" class="btn btn--solid" data-sent="We'll be in touch">Request viewing</button>
      </form>
      <div class="info" data-reveal>
        <div>
          <div class="label">Hours</div>
          <div class="text">Every day · 08:00 – 20:00 IST</div>
        </div>
        <div>
          <div class="label">Direct</div>
          <div class="text text--ink">
            <a href="tel:+919967777648">+91 99677 77648</a> · <a href="https://wa.me/919967777648" target="_blank" rel="noopener">WhatsApp</a><br />
            <a href="mailto:bmscarz@gmail.com">bmscarz@gmail.com</a>
          </div>
        </div>
      </div>
    </div>
    <div class="location" data-reveal>
      <div class="location__addr">
        <div class="label">Showroom</div>
        <div class="addr">Shop No. C3, Shah Arcade, Sector 6<br />Kharghar, Panvel, Maharashtra 410210</div>
        <a href={DIRECTIONS} class="link-line directions" target="_blank" rel="noopener">Get directions</a>
      </div>
      <div class="map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4090.6690937681888!2d73.0608803110233!3d19.043096452929742!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7c3041fa7d2a5%3A0xf50138dcbd4c1c09!2sBms%20carz!5e0!3m2!1sen!2sin!4v1793014643027!5m2!1sen!2sin"
          title="BMS Carz on Google Maps" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: clamp(48px, 7vw, 110px); margin-top: 90px; }
  .form { display: grid; gap: 30px; align-content: start; }
  .form .btn { justify-self: start; margin-top: 10px; padding: 18px 38px; }
  .info { display: grid; gap: 40px; align-content: start; }
  @media (max-width: 600px) {
    .grid { margin-top: 48px; gap: 56px; }
    .addr { font-size: 19px; }
  }
  .addr { margin-top: 12px; font-size: 22px; font-weight: 300; line-height: 1.4; }
  .text { margin-top: 12px; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(244, 245, 247,.78); }
  .text--ink { color: var(--ink); }
  .directions { display: inline-flex; margin-top: 18px; }
  /* Address beside the map, laid out like the Zyflux location row (1 : 2). */
  .location {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1px; margin-top: clamp(64px, 8vw, 110px);
    background: rgba(244, 245, 247,.12); border: 1px solid rgba(244, 245, 247,.12);
  }
  .location__addr { background: var(--bg); padding: clamp(24px, 3vw, 40px); }
  @media (max-width: 1024px) { .location { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); } }
  @media (max-width: 760px) { .location { grid-template-columns: 1fr; } }
  .map { min-height: 260px; overflow: hidden; background: var(--surface); }
  /* Google's embed has no dark style, so invert the street map and turn the hues back round. */
  .map iframe { width: 100%; height: 100%; min-height: 260px; border: 0; display: block; filter: invert(90%) hue-rotate(180deg) saturate(.85) brightness(.9); }
</style>

<script>
  import { bindInlineForms } from '../scripts/forms';
  bindInlineForms();
</script>
