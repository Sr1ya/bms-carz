---
// Intro loader, generated at build time from public/images/bms-carz-logo-dark.svg.
// A single inline SVG with plain CSS animations, the same approach as the original
// bms-carz-animated.html, because that is what renders smoothly; extra layering,
// masks or containment made it slower, not faster.
// Base.astro decides whether it runs (arrival and reload, not internal navigation).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const src = readFileSync(join(process.cwd(), 'public', 'images', 'bms-carz-logo-dark.svg'), 'utf8');

const attr = (s: string, name: string) => s.match(new RegExp(`\\s${name}="([^"]*)"`))?.[1];
/** Attributes of the element carrying this id. */
const el = (id: string) => {
  const m = src.match(new RegExp(`<\\w+\\s+id="${id}"([^>]*?)/?>`));
  if (!m) throw new Error(`Logo SVG is missing id="${id}"`);
  return m[1];
};
const subpaths = (d: string) => d.split(/(?=M)/).map((s) => s.trim()).filter(Boolean);
const startX = (d: string) => parseFloat(d.slice(1));
const num = (s: string, name: string) => parseFloat(attr(s, name)!);

const viewBox = attr(src.match(/<svg[^>]*>/)![0], 'viewBox');

// Car: split the silhouette into its subpaths so each piece draws on in turn.
const carPieces = subpaths(attr(el('car'), 'd')!);
const carStep = Math.min(0.05, 0.6 / Math.max(1, carPieces.length - 1));
const wheelWidth = src.match(/<g[^>]*stroke-width="([^"]*)"[^>]*>\s*<circle/)?.[1] ?? '22';
const wheels = [...src.matchAll(/<circle([^>]*)\/>/g)].map((m) => ({
  cx: attr(m[1], 'cx'), cy: attr(m[1], 'cy'), r: attr(m[1], 'r'),
}));

const badge = el('badge');
const by = num(badge, 'y'), bh = num(badge, 'height');

const stripes = [...src.match(/<g id="stripes">([\s\S]*?)<\/g>/)![1].matchAll(/<path([^>]*)\/>/g)]
  .map((m) => ({ d: attr(m[1], 'd')!, fill: attr(m[1], 'fill') }));

// BMS slides out from behind the last stripe: clip everything left of that stripe's slanted right edge.
const edge = stripes[stripes.length - 1].d.match(/M\s*[-\d.]+,([-\d.]+)\s*H\s*([-\d.]+)\s*L\s*([-\d.]+),([-\d.]+)/); // M tl H tr L br H bl
if (!edge) throw new Error('Logo SVG stripes are not in the expected "M x,y H x L x,y H x Z" form');
const top = [+edge[2], +edge[1]], bottom = [+edge[3], +edge[4]];
const slope = (bottom[0] - top[0]) / (bottom[1] - top[1]);
const edgeAt = (y: number) => (top[0] + (y - top[1]) * slope).toFixed(1);
const emerge = `${edgeAt(by)},${by} 1200,${by} 1200,${by + bh} ${edgeAt(by + bh)},${by + bh}`;

const bmsD = attr(el('bms'), 'd')!;
const chrome = src.match(/<linearGradient id="chrome"([^>]*)>([\s\S]*?)<\/linearGradient>/)!;

// CARZ: one outlined path; group its subpaths back into letters, left to right
// (the A's crossbar starts close to the A, so it joins it).
const carz: { x: number; d: string }[] = [];
for (const d of subpaths(attr(el('carz'), 'd')!).sort((a, b) => startX(a) - startX(b))) {
  const last = carz[carz.length - 1];
  if (last && startX(d) - last.x < 100) last.d += ` ${d}`;
  else carz.push({ x: startX(d), d });
}
---

<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__logo">
    <svg class="bms-logo" viewBox={viewBox} role="img" aria-label="BMS Carz">
      <defs>
        <linearGradient id="shineGrad" x1="0" x2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset=".5" stop-color="#fff" stop-opacity=".7" /><stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="loaderChrome" x1={attr(chrome[1], 'x1')} y1={attr(chrome[1], 'y1')} x2={attr(chrome[1], 'x2')} y2={attr(chrome[1], 'y2')} gradientUnits="userSpaceOnUse" set:html={chrome[2]} />
        <clipPath id="bmsClip"><path d={bmsD} /></clipPath>
        <clipPath id="emerge"><polygon points={emerge} /></clipPath>
      </defs>
      {carPieces.map((d, i) => (
        <path class="draw car-piece" pathLength="1" style={`--d:${(i * carStep).toFixed(2)}s`} d={d} />
      ))}
      {wheels.map((w, i) => (
        <circle class="wheel" pathLength="1" style={`--d:${0.35 + i * 0.15}s;stroke-width:${wheelWidth}`} cx={w.cx} cy={w.cy} r={w.r} />
      ))}
      <rect class="badge" x={attr(badge, 'x')} y={by} width={attr(badge, 'width')} height={bh} rx={attr(badge, 'rx')}
        fill={attr(badge, 'fill')} stroke={attr(badge, 'stroke')} stroke-width={attr(badge, 'stroke-width')} />
      {stripes.map((s, i) => (
        <path class="stripe" style={`--d:${(1.45 + i * 0.1).toFixed(2)}s`} fill={s.fill} d={s.d} />
      ))}
      <g clip-path="url(#emerge)">
        <g class="ltr" style="--d:2s;--x:-820px"><path d={bmsD} /></g>
        <g clip-path="url(#bmsClip)"><g transform="skewX(-24)"><rect class="shine" x="0" y={by} width="200" height={bh} fill="url(#shineGrad)" /></g></g>
      </g>
      {carz.map((l, i) => (
        <path class="letter" style={`--d:${(2.7 + i * 0.12).toFixed(2)}s`} d={l.d} />
      ))}
    </svg>
  </div>
</div>

<style is:global>
  .loader {
    position: fixed; inset: 0; z-index: 100; display: none; place-items: center; background: var(--bg);
    overflow: hidden; /* the logo shine sweeps past the screen edge */
  }
  .is-loading .loader, .loader.is-done { display: grid; }
  .is-loading body { overflow: hidden; }
  /* Nothing else paints while the logo draws, except the page itself sitting still under the
     opaque loader: without a painted main image Lighthouse has no LCP and Performance errors out. */
  .is-loading body > :not(.loader, main) { visibility: hidden; }
  .loader:not(.is-playing) .bms-logo * { animation-play-state: paused !important; }
  /* Scales with the screen: ~56% of width on phones, capped at 360px on desktop,
     and limited by height so it stays modest on landscape phones. */
  .loader__logo { width: clamp(180px, 56vw, 360px); max-width: 90svh; }

  /* Exit: logo slides up and out, then the curtain slides up to reveal the page. */
  .loader.is-done {
    transform: translateY(-100%); visibility: hidden;
    transition: transform .95s cubic-bezier(.76, 0, .24, 1) .08s, visibility 0s linear 1.1s;
  }
  .loader.is-done .loader__logo {
    transform: translateY(-90px); opacity: 0;
    transition: transform .7s cubic-bezier(.76, 0, .24, 1), opacity .45s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .loader.is-done { transition: opacity .5s ease, visibility 0s linear .5s; transform: none; opacity: 0; }
    .loader.is-done .loader__logo { transform: none; }
  }

  /* ===== logo animation: car draws on, wheels spin in, the badge opens, stripes slide in,
     chrome BMS slides out from behind the stripes, CARZ rises, a shine crosses BMS ===== */
  .bms-logo{width:100%;height:auto;display:block;overflow:visible;--fg:#f4f5f7}
  .bms-logo .draw{fill:var(--fg);fill-opacity:0;stroke:var(--fg);stroke-width:2.5;
     stroke-dasharray:1;stroke-dashoffset:1;
     animation:draw 1.3s cubic-bezier(.65,0,.35,1) var(--d,0s) forwards, fillin .5s ease-out calc(var(--d,0s) + 1.05s) forwards}
  .bms-logo .wheel{fill:none;stroke:var(--fg);stroke-dasharray:1;stroke-dashoffset:1;
     transform-box:fill-box;transform-origin:center;
     animation:wheel 1.1s cubic-bezier(.3,.7,.2,1) var(--d) forwards}
  .bms-logo .badge{opacity:0;transform:scaleX(.55);transform-box:fill-box;transform-origin:center;
     animation:badge .7s cubic-bezier(.2,.8,.2,1) 1.1s forwards}
  .bms-logo .stripe{opacity:0;transform:translateX(-60px);animation:stripe .5s cubic-bezier(.2,.8,.2,1) var(--d) forwards}
  .bms-logo .ltr{fill:url(#loaderChrome);transform:translateX(var(--x));
     animation:emerge .9s cubic-bezier(.16,.9,.25,1) var(--d) forwards}
  @keyframes emerge{0%{transform:translateX(var(--x)) scaleX(1.25)}100%{transform:none}}
  .bms-logo .letter{fill:var(--fg);opacity:0;transform:translateY(22px);animation:up .5s cubic-bezier(.2,.8,.2,1) var(--d) forwards}
  .bms-logo .shine{opacity:0;animation:shine .85s ease-in-out 3.25s forwards}
  @keyframes draw{to{stroke-dashoffset:0}}
  @keyframes fillin{to{fill-opacity:1;stroke-width:0}}
  @keyframes wheel{from{stroke-dashoffset:1;transform:rotate(-200deg)}to{stroke-dashoffset:0;transform:rotate(0)}}
  @keyframes badge{to{opacity:1;transform:none}}
  @keyframes stripe{to{opacity:1;transform:none}}
  @keyframes up{to{opacity:1;transform:none}}
  @keyframes shine{0%{opacity:1;transform:translateX(460px)}100%{opacity:1;transform:translateX(1220px)}}
  @media (prefers-reduced-motion:reduce){
    .bms-logo *{animation:none!important;opacity:1!important;transform:none!important;stroke-dashoffset:0!important;fill-opacity:1!important}
    .bms-logo .draw{stroke-width:0} .bms-logo .shine{display:none}
  }
</style>
