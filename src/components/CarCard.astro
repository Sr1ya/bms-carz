---
import { type Car, money, carName, lakhs, photo, summary } from '../data/cars';

interface Props {
  car: Car;
  index: number;
  variant?: 'featured' | 'grid' | 'related';
}

const { car, index, variant = 'grid' } = Astro.props;
const delay = `${((index % 3) * 0.12).toFixed(2)}s`;
---

<a
  href={`/cars/${car.id}/`}
  class:list={['card', `card--${variant}`]}
  style={`transition-delay: ${delay}`}
  data-reveal
  data-cat={car.cat}
  data-price={lakhs(car) ?? ''}
  data-order={index}
>
  <div class="card__media">
    <div class="zoom">
      <img class="card__img" src={photo(car)} alt={carName(car)} loading="lazy" decoding="async" width="1080" height="1350" />
    </div>
  </div>
  {variant === 'related' ? (
    <div class="card__row card__row--related">
      <div class="card__model--related">{car.model}</div>
      <div class="price">{money(car)}</div>
    </div>
  ) : (
    <>
      <div class="card__row">
        <div class="meta">{[car.year, car.make].filter(Boolean).join(' · ')}</div>
        <div class="price">{money(car)}</div>
      </div>
      <h3 class="card__model">{car.model}</h3>
      <div class="card__specs">{summary(car)}</div>
    </>
  )}
</a>

<style>
  .card { display: block; color: inherit; }
  .card:hover { color: inherit; }
  .card[hidden] { display: none; }
  /* Stock photos are shot 4:5 portrait (a few square), so keep cards close to that. */
  .card__media { position: relative; overflow: hidden; background: var(--surface); aspect-ratio: 4 / 5; }
  .card--related .card__media { aspect-ratio: 1 / 1; }
  .card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .card__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 22px; }
  .card__row--related { gap: 12px; margin-top: 18px; }
  .meta { font-size: 10px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: rgba(244, 245, 247, .5); }
  .price { font-size: 13px; letter-spacing: .04em; color: var(--ink); white-space: nowrap; }
  .card__model { margin: 10px 0 0; font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-weight: 400; font-size: 18px; line-height: 1.2; letter-spacing: .01em; }
  .card--featured .card__model { font-size: 30px; }
  .card__model--related { font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-size: 15px; }
  .card__specs { margin-top: 10px; font-size: 12px; font-weight: 300; letter-spacing: .06em; color: rgba(244, 245, 247, .55); }
  .card--featured .card__specs { margin-top: 12px; }
  /* Phones show the collection two-up, so the text steps down to fit a half-width card. */
  @media (max-width: 600px) {
    /* Stack every card the same way: make, model, price, details. */
    .card--grid { display: flex; flex-direction: column; }
    .card--grid .card__row { display: contents; }
    .card--grid .meta { order: 1; margin-top: 12px; }
    .card--grid .card__model { order: 2; }
    .card--grid .price { order: 3; margin-top: 6px; }
    .card--grid .card__specs { order: 4; }
    .card--related .card__row { flex-direction: column; align-items: flex-start; gap: 4px; margin-top: 12px; }
    .card--grid .meta { letter-spacing: .2em; font-size: 9px; }
    .card--grid .price, .card--related .price { font-size: 11px; }
    .card--grid .card__model { margin-top: 6px; font-size: 14px; }
    .card--grid .card__specs { margin-top: 6px; font-size: 11px; letter-spacing: .02em; }
    .card__model--related { font-size: 13px; }
    .card--featured .card__model { font-size: 24px; }
  }
</style>
