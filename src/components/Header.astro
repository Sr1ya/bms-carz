---
import Logo from './Logo.astro';

interface Props {
  /** Transparent until scrolled (home hero); solid everywhere else. */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/collection/', label: 'Collection' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class:list={['site-header', { 'is-solid': !overlay }]} data-overlay={overlay ? '' : undefined}>
  <a href="/" class="brand" aria-label="BMS Carz home">
    <Logo class="brand__logo" />
  </a>
  <nav class="nav" aria-label="Main">
    <div class="nav__links" id="nav-links">
      {links.map((l) => (
        <a href={l.href} class="nav__link" aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <!-- Phone menu only: the actions the header has no room for. -->
      <div class="nav__extra">
        <a href="/contact/" class="btn btn--solid">Book a viewing</a>
        <a href="tel:+919967777648" class="btn btn--line">Call +91 99677 77648</a>
        <p class="nav__where">Shop C3, Shah Arcade, Sector 6, Kharghar<br />Open daily, 8am–8pm</p>
      </div>
    </div>
    <a href="/contact/" class="nav__cta">Book a viewing</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">Menu</span><span></span><span></span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 60;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 26px var(--gutter); border-bottom: 1px solid transparent;
    transition: background .6s ease, padding .6s ease, border-color .6s ease;
  }
  .site-header.is-solid {
    padding-top: 18px; padding-bottom: 18px; background: rgba(0, 0, 0, .82);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); border-bottom-color: rgba(244, 245, 247, .08);
  }
  .brand { display: block; color: var(--ink); line-height: 0; }
  .brand:hover { color: var(--ink); }
  .brand :global(.brand__logo) { display: block; height: 46px; width: auto; transition: height .6s ease; }
  .site-header.is-solid .brand :global(.brand__logo) { height: 38px; }

  .nav { display: flex; align-items: center; gap: clamp(14px, 2.6vw, 40px); font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
  .nav__links { display: flex; gap: clamp(14px, 2.6vw, 40px); }
  .nav__link { color: rgba(244, 245, 247, .7); transition: color .4s; }
  .nav__link:hover, .nav__link[aria-current] { color: var(--ink); }
  .nav__cta { padding: 12px 22px; border: 1px solid rgba(244, 245, 247, .28); white-space: nowrap; transition: border-color .4s, background .4s, color .4s; }
  .nav__cta:hover { border-color: var(--ink); background: var(--ink); color: var(--bg); }

  .nav__toggle { display: none; position: relative; width: 28px; height: 28px; padding: 0; background: none; border: 0; cursor: pointer; }
  .nav__toggle span:not(.sr-only) { position: absolute; left: 4px; right: 4px; height: 1px; background: var(--ink); transition: transform .4s var(--ease); }
  .nav__toggle span:nth-child(2) { top: 11px; }
  .nav__toggle span:nth-child(3) { top: 17px; }
  .nav__toggle[aria-expanded='true'] span:nth-child(2) { transform: translateY(3px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-3px) rotate(-45deg); }

  .nav__extra { display: none; }

  @media (max-width: 760px) {
    .site-header { padding-top: 18px; padding-bottom: 18px; }
    .site-header.is-solid { padding-top: 12px; padding-bottom: 12px; background: rgba(0, 0, 0, .94); }
    .brand :global(.brand__logo) { height: 40px; }
    .site-header.is-solid .brand :global(.brand__logo) { height: 34px; }
    .nav__toggle { display: block; width: 44px; height: 44px; margin-right: -8px; }
    .nav__toggle span:not(.sr-only) { left: 12px; right: 12px; }
    .nav__toggle span:nth-child(2) { top: 19px; }
    .nav__toggle span:nth-child(3) { top: 25px; }
    .nav__cta { padding: 10px 14px; letter-spacing: .18em; }
    /* Full-screen menu: big tap targets, plus the booking and call actions. */
    .nav__links {
      position: fixed; inset: 0; z-index: -1; flex-direction: column; gap: 0;
      height: 100vh; height: 100dvh; overflow-y: auto; padding: 104px var(--gutter) 40px; background: #000;
      transform: translateY(-100%); transition: transform .6s var(--ease), visibility 0s .6s; visibility: hidden;
    }
    .nav__links.is-open { transform: none; visibility: visible; transition: transform .6s var(--ease); }
    .nav__link {
      padding: 18px 0; border-bottom: 1px solid rgba(244, 245, 247, .1);
      font-family: var(--display); font-stretch: 125%; font-size: 26px; font-weight: 400; letter-spacing: .02em; color: var(--ink);
    }
    .nav__link[aria-current] { color: var(--accent); }
    .nav__extra { display: grid; gap: 12px; margin-top: 36px; letter-spacing: .2em; }
    .nav__extra .btn { padding: 17px; }
    .nav__where { margin: 18px 0 0; font-size: 13px; font-weight: 300; line-height: 1.7; letter-spacing: 0; text-transform: none; color: rgba(244, 245, 247, .55); }
  }
  /* Small phones: the menu carries "Book a viewing", so the header keeps just logo + menu. */
  @media (max-width: 480px) { .nav__cta { display: none; } }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.nav__toggle')!;
  const links = header.querySelector<HTMLElement>('.nav__links')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    links.classList.toggle('is-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  links.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  if (header.hasAttribute('data-overlay')) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 60);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
