---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">
  <section class="page">
    <div class="eyebrow" data-reveal>Contact</div>
    <h1 class="page-title">
      <span class="mask"><span data-line data-hero-reveal>Arrange a <span class="it">private viewing.</span></span></span>
    </h1>
    <div class="grid">
      <form class="form" data-reveal data-inline-form>
        <label class="sr-only" for="c-name">Your name</label>
        <input id="c-name" name="name" class="field" placeholder="Your name" autocomplete="name" required />
        <label class="sr-only" for="c-phone">Phone</label>
        <input id="c-phone" name="phone" type="tel" class="field" placeholder="Phone" autocomplete="tel" required />
        <label class="sr-only" for="c-note">Which car, and when suits you?</label>
        <textarea id="c-note" name="note" rows="3" class="field" placeholder="Which car, and when suits you?"></textarea>
        <button type="submit" class="btn btn--solid" data-sent="We'll be in touch">Request viewing</button>
      </form>
      <div class="info" data-reveal>
        <div>
          <div class="label">Showroom</div>
          <div class="addr">Shop No. C3, Shah Arcade, Sector 6<br />Kharghar, Panvel, Maharashtra 410210</div>
        </div>
        <div>
          <div class="label">Hours</div>
          <div class="text">Every day · 08:00 – 20:00 IST</div>
        </div>
        <div>
          <div class="label">Direct</div>
          <div class="text text--ink">
            <a href="tel:+917947137079">+91 79 4713 7079</a><br />
            <a href="mailto:bmscarz@gmail.com">bmscarz@gmail.com</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: clamp(48px, 7vw, 110px); margin-top: 90px; }
  .form { display: grid; gap: 30px; align-content: start; }
  .form .btn { justify-self: start; margin-top: 10px; padding: 18px 38px; }
  .info { display: grid; gap: 40px; align-content: start; }
  .addr { margin-top: 12px; font-size: 22px; font-weight: 300; line-height: 1.4; }
  .text { margin-top: 12px; font-size: 15px; font-weight: 300; line-height: 1.8; color: rgba(244, 245, 247,.78); }
  .text--ink { color: var(--ink); }
</style>

<script>
  import { bindInlineForms } from '../scripts/forms';
  import { CARS, carName } from '../data/cars';

  // Prefill from "Book a test drive" on a car page.
  const id = new URLSearchParams(location.search).get('car');
  const car = CARS.find((c) => c.id === id);
  const note = document.getElementById('c-note') as HTMLTextAreaElement;
  if (car && !note.value) note.value = `Test drive — ${carName(car)}. `;

  bindInlineForms();
</script>
