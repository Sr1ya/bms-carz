---
import Base from '../../layouts/Base.astro';
import CarCard from '../../components/CarCard.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { CARS, type Car, money, emi, carName, photo, photoAt, photoSrcset } from '../../data/cars';

/** Width and height of a WebP, read from its header (lossy, lossless or extended). */
function webpSize(file: string): [number, number] {
  const b = readFileSync(file);
  const kind = b.toString('ascii', 12, 16);
  if (kind === 'VP8 ') return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
  if (kind === 'VP8L') { const n = b.readUInt32LE(21); return [(n & 0x3fff) + 1, ((n >> 14) & 0x3fff) + 1]; }
  return [b.readUIntLE(24, 3) + 1, b.readUIntLE(27, 3) + 1];
}

export function getStaticPaths() {
  return CARS.map((car) => ({ params: { id: car.id }, props: { car } }));
}

const { car } = Astro.props as { car: Car };
const related = CARS.filter((c) => c.id !== car.id && c.cat === car.cat).slice(0, 3);
const monthly = emi(car);
const whatsapp = `https://wa.me/919967777648?text=${encodeURIComponent(`Hi BMS Carz, I'm interested in the ${carName(car)} (${car.colour}).`)}`;
const shots = Array.from({ length: car.photos }, (_, i) => photo(car, i + 1));
// Each car's set is all portrait (4:5) or all square, so the viewer takes the first photo's shape.
const [pw, ph] = webpSize(join(process.cwd(), 'public', shots[0]));
const specs: [string, string][] = [
  ['Colour', car.colour],
  ['Body', car.cat],
  ...([['Year', car.year && String(car.year)], ['Kilometres', car.kms], ['Fuel', car.fuel], ['Gearbox', car.gearbox]]
    .filter(([, v]) => v) as [string, string][]),
  ...(car.specs ?? []),
];
---

<Base title={carName(car)} description={car.blurb ?? `${carName(car)} in ${car.colour.toLowerCase()}, available at BMS Carz, Kharghar.`}>
  <section class="detail">
    <a href="/collection/" class="back">← The collection</a>
    <div class="top">
      <div>
        <div class="eyebrow">{[car.year, car.make].filter(Boolean).join(' · ')}</div>
        <h1 class="title">
          <span class="mask"><span data-line data-hero-reveal>{car.model}</span></span>
        </h1>
      </div>
      <div class="price">
        <div class="price__amount">{money(car)}</div>
        {monthly && <div class="price__emi">Finance from {monthly} / month</div>}
      </div>
    </div>

    <div class="body">
      <!-- One whole photo at a time (no sideways scrolling): swipe or arrows to change, tap for full screen. -->
      <div class="viewer" data-reveal style={`width: min(100%, calc(78vh * ${(pw / ph).toFixed(4)}))`}>
        <div class="viewer__stage" id="viewer-stage" style={`aspect-ratio: ${pw} / ${ph}`} role="button" tabindex="0" aria-label="View photos full screen">
          <div class="strip">
            {shots.map((src, i) => (
              <div class="slide">
                <img src={src} srcset={photoSrcset(car, i + 1, pw)} sizes={`(max-width: 900px) calc(100vw - 40px), min(55vw, ${Math.round(78 * pw / ph)}vh)`} alt={`${carName(car)}, photo ${i + 1} of ${shots.length}`} width={pw} height={ph}
                  loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : 'low'} draggable="false" />
              </div>
            ))}
          </div>
          <span class="viewer__expand" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
          </span>
        </div>
        <button type="button" class="viewer__nav viewer__nav--prev" data-step="-1" aria-label="Previous photo">‹</button>
        <button type="button" class="viewer__nav viewer__nav--next" data-step="1" aria-label="Next photo">›</button>
        <div class="viewer__count label" id="viewer-count">1 / {shots.length}</div>
        <div class="thumbs" id="viewer-thumbs">
          {shots.map((_, i) => (
            <button type="button" class="thumb" aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
              <img src={photoAt(car, i + 1, 160)} alt="" loading="eager" decoding="async" fetchpriority="low" width="160" height={Math.round(160 * ph / pw)} />
            </button>
          ))}
        </div>
      </div>

      <dialog class="lb" id="lb" aria-label={`${carName(car)} photos`}>
        <div class="lb__bar">
          <span class="label" id="lb-count">1 / {shots.length}</span>
          <button type="button" class="lb__close" id="lb-close" aria-label="Close">×</button>
        </div>
        <div class="lb__stage" id="lb-stage">
          <div class="strip">
            {shots.map((src, i) => (
              <div class="slide"><img src={src} alt={`${carName(car)}, photo ${i + 1} of ${shots.length}`} loading="lazy" decoding="async" draggable="false" /></div>
            ))}
          </div>
        </div>
        <button type="button" class="lb__nav lb__nav--prev" data-step="-1" aria-label="Previous photo">‹</button>
        <button type="button" class="lb__nav lb__nav--next" data-step="1" aria-label="Next photo">›</button>
      </dialog>

      <div class="info">
        {car.blurb && <p class="blurb" data-reveal>{car.blurb}</p>}
        <dl class="specs" data-reveal>
          {specs.map(([k, v]) => (
            <div class="spec">
              <dt class="label">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <aside class="panel" data-reveal>
          <div class="eyebrow">Enquire</div>
          <p class="panel__text">Ask us about this {car.model}: availability, price or a viewing.</p>
          <a href={whatsapp} class="panel__btn panel__btn--wa" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
            Chat on WhatsApp
          </a>
          <a href="tel:+919967777648" class="panel__btn panel__btn--call">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
            Call the showroom
          </a>
        </aside>
      </div>
    </div>

      {related.length > 0 && (
        <div class="related">
          <div class="related__head" data-reveal>
            <h2 class="related__title">You may also consider</h2>
            <a href="/collection/" class="related__all">View all</a>
          </div>
          <div class="related__grid">
            {related.map((c, i) => <CarCard car={c} index={i} variant="related" />)}
          </div>
        </div>
      )}
  </section>
</Base>

<style>
  .detail { padding: 150px var(--gutter) 140px; }
  .back { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: rgba(244, 245, 247,.6); transition: color .4s; }
  .back:hover { color: var(--ink); }
  .top { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-top: 32px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .top .eyebrow { letter-spacing: .34em; }
  .title { margin: 14px 0 0; font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-weight: 400; font-size: clamp(30px, 5vw, 80px); line-height: .98; overflow-wrap: break-word; }
  .price { text-align: right; }
  .price__amount { font-family: var(--display); font-stretch: 125%; font-weight: 400; font-size: clamp(20px, 2.2vw, 32px); }
  .price__emi { margin-top: 6px; font-size: 11px; letter-spacing: .14em; color: rgba(244, 245, 247,.55); }
  @media (max-width: 600px) { .price { text-align: left; } }

  .body { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); margin-top: 48px; align-items: start; }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } }

  .viewer { position: relative; }
  .viewer__stage { position: relative; overflow: hidden; background: var(--surface); cursor: zoom-in; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  /* Photos sit side by side in a strip that's moved with transform (not scrolled), so the
     page can never scroll sideways; each slide shows one whole, uncropped photo. */
  .strip { display: flex; height: 100%; transition: transform .45s cubic-bezier(.22, .61, .36, 1); will-change: transform; }
  .strip.is-dragging { transition: none; }
  .slide { flex: 0 0 100%; height: 100%; display: grid; place-items: center; overflow: hidden; }
  .slide img { width: 100%; height: 100%; object-fit: contain; display: block; -webkit-user-drag: none; }
  .viewer__stage .strip { position: absolute; inset: 0; }
  .viewer__expand { position: absolute; top: 10px; right: 10px; display: grid; place-items: center; width: 34px; height: 34px; background: rgba(0, 0, 0, .55); color: var(--ink); pointer-events: none; }
  .viewer__nav {
    position: absolute; top: calc(50% - 40px); width: 44px; height: 44px; border: 1px solid rgba(244, 245, 247, .24);
    background: rgba(0, 0, 0, .55); color: var(--ink); font-size: 26px; line-height: 1; cursor: pointer; transition: border-color .3s, opacity .3s;
  }
  .viewer__nav:hover { border-color: var(--ink); }
  .viewer__nav:disabled { opacity: 0; pointer-events: none; }
  .viewer__nav--prev { left: 10px; }
  .viewer__nav--next { right: 10px; }
  .viewer__count { margin-top: 14px; }
  /* Thumbnails wrap onto rows instead of scrolling sideways. */
  .thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 8px; margin-top: 14px; }
  .thumb { aspect-ratio: 1; padding: 0; border: 1px solid transparent; background: var(--surface); cursor: pointer; opacity: .5; transition: opacity .3s, border-color .3s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb:hover { opacity: .85; }
  .thumb[aria-current='true'] { opacity: 1; border-color: var(--ink); }

  .lb { width: 100vw; height: 100vh; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #000; color: var(--ink); overflow: hidden; }
  .lb[open] { display: flex; flex-direction: column; }
  .lb::backdrop { background: #000; }
  .lb__bar { display: flex; justify-content: space-between; align-items: center; padding: 12px var(--gutter); }
  .lb__close { width: 44px; height: 44px; margin-right: -10px; background: none; border: 0; color: var(--ink); font-size: 34px; line-height: 1; cursor: pointer; }
  .lb__stage { flex: 1; min-height: 0; overflow: hidden; padding-bottom: 20px; touch-action: none; user-select: none; -webkit-user-select: none; }
  .lb__nav {
    position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border: 1px solid rgba(244, 245, 247, .24);
    background: rgba(0, 0, 0, .55); color: var(--ink); font-size: 28px; line-height: 1; cursor: pointer;
  }
  .lb__nav:disabled { opacity: 0; pointer-events: none; }
  .lb__nav--prev { left: 10px; }
  .lb__nav--next { right: 10px; }

  .blurb { margin: 0 0 40px; font-weight: 300; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.5; text-wrap: pretty; }
  .specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0 36px; margin: 0; }
  .spec { padding: 20px 0; border-top: 1px solid var(--line); }
  .spec .label { letter-spacing: .28em; }
  .spec dd { margin: 10px 0 0; font-size: 16px; font-weight: 300; }

  .panel { margin-top: 40px; padding: 32px; border: 1px solid rgba(244, 245, 247,.12); background: #000; }
  .panel .eyebrow { letter-spacing: .34em; }
  .panel__text { margin: 14px 0 24px; font-size: 14px; font-weight: 300; line-height: 1.6; color: rgba(244, 245, 247,.65); }
  .panel__btn {
    display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 54px; padding: 0 18px;
    font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; transition: background .3s, border-color .3s, color .3s;
  }
  .panel__btn--wa { background: #25d366; color: #04140a; }
  .panel__btn--wa:hover { background: #3ee07a; color: #04140a; }
  .panel__btn--call { margin-top: 10px; border: 1px solid rgba(244, 245, 247,.3); color: var(--ink); }
  .panel__btn--call:hover { border-color: var(--ink); color: var(--ink); }
  @media (max-width: 600px) { .panel { padding: 26px 20px; } }

  .related { margin-top: 140px; }
  .related__head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .related__title { margin: 0; font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-weight: 400; font-size: 28px; }
  .related__all { font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(244, 245, 247,.65); white-space: nowrap; }
  .related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: clamp(20px, 2.4vw, 36px); margin-top: 40px; }
  @media (max-width: 600px) {
    .detail { padding-top: 104px; padding-bottom: 96px; }
    .top { margin-top: 22px; padding-bottom: 24px; }
    .body { margin-top: 28px; }
    .related { margin-top: 88px; }
    .related__title { font-size: 22px; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
    .related__grid > :global(:nth-child(n + 3)) { display: none; }
  }
</style>

<script>
  const stage = document.getElementById('viewer-stage')!;
  const lbStage = document.getElementById('lb-stage')!;
  const strips = [...document.querySelectorAll<HTMLElement>('.strip')];
  const count = document.getElementById('viewer-count')!;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('#viewer-thumbs .thumb')];
  const navs = [...document.querySelectorAll<HTMLButtonElement>('.viewer__nav, .lb__nav')];
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const lbCount = document.getElementById('lb-count')!;
  const total = thumbs.length;
  let i = 0;

  const place = (strip: HTMLElement, dx = 0) => { strip.style.transform = `translate3d(calc(${-i * 100}% + ${dx}px), 0, 0)`; };

  function show(n: number) {
    i = Math.max(0, Math.min(total - 1, n));
    strips.forEach((st) => { st.classList.remove('is-dragging'); place(st); });
    thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    count.textContent = lbCount.textContent = `${i + 1} / ${total}`;
    for (const b of navs) b.disabled = Number(b.dataset.step) < 0 ? i === 0 : i === total - 1;
  }

  // The photo follows the finger sideways, then slides to the next/previous one (or back).
  // A tap with no real movement runs onTap. Vertical drags are left to the page to scroll.
  function swipe(el: HTMLElement, onTap?: () => void) {
    const strip = el.querySelector<HTMLElement>('.strip')!;
    let x0 = 0, y0 = 0, id = -1, dragging = false;
    el.addEventListener('pointerdown', (e) => { id = e.pointerId; x0 = e.clientX; y0 = e.clientY; dragging = false; });
    el.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      let dx = e.clientX - x0;
      const dy = e.clientY - y0;
      if (!dragging && Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(dy)) { dragging = true; strip.classList.add('is-dragging'); }
      if (!dragging) return;
      if ((i === 0 && dx > 0) || (i === total - 1 && dx < 0)) dx *= 0.3; // resist past the ends
      place(strip, dx);
    });
    el.addEventListener('pointerup', (e) => {
      if (e.pointerId !== id) return;
      id = -1;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      const flick = Math.abs(dx) > Math.min(60, el.clientWidth * 0.18);
      if (dragging) show(flick ? i + (dx < 0 ? 1 : -1) : i);
      else if (Math.abs(dx) < 8 && Math.abs(dy) < 8) onTap?.();
      dragging = false;
    });
    el.addEventListener('pointercancel', () => { id = -1; if (dragging) show(i); dragging = false; });
  }

  const open = () => {
    lb.showModal();
    document.documentElement.style.overflow = 'hidden';
    show(i);
  };
  swipe(stage, open);
  swipe(lbStage);
  stage.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
  lb.addEventListener('close', () => { document.documentElement.style.overflow = ''; });
  document.getElementById('lb-close')!.addEventListener('click', () => lb.close());
  for (const b of navs) b.addEventListener('click', () => show(i + Number(b.dataset.step)));
  thumbs.forEach((t, k) => t.addEventListener('click', () => show(k)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1);
  });
  show(0);
</script>
