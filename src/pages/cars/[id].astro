---
import Base from '../../layouts/Base.astro';
import CarCard from '../../components/CarCard.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { CARS, type Car, money, emi, carName, photo } from '../../data/cars';

/** Width and height of a WebP, read from its header (lossy, lossless or extended). */
function webpSize(file: string): [number, number] {
  const b = readFileSync(file);
  const kind = b.toString('ascii', 12, 16);
  if (kind === 'VP8 ') return [b.readUInt16LE(26) & 0x3fff, b.readUInt16LE(28) & 0x3fff];
  if (kind === 'VP8L') { const n = b.readUInt32LE(21); return [(n & 0x3fff) + 1, ((n >> 14) & 0x3fff) + 1]; }
  return [b.readUIntLE(24, 3) + 1, b.readUIntLE(27, 3) + 1];
}

export function getStaticPaths() {
  return CARS.map((car) => ({ params: { id: car.id }, props: { car } }));
}

const { car } = Astro.props as { car: Car };
const related = CARS.filter((c) => c.id !== car.id && c.cat === car.cat).slice(0, 3);
const monthly = emi(car);
const shots = Array.from({ length: car.photos }, (_, i) => photo(car, i + 1));
// Each car's set is all portrait (4:5) or all square, so the viewer takes the first photo's shape.
const [pw, ph] = webpSize(join(process.cwd(), 'public', shots[0]));
const specs: [string, string][] = [
  ['Colour', car.colour],
  ['Body', car.cat],
  ...([['Year', car.year && String(car.year)], ['Kilometres', car.kms], ['Fuel', car.fuel], ['Gearbox', car.gearbox]]
    .filter(([, v]) => v) as [string, string][]),
  ...(car.specs ?? []),
];
---

<Base title={carName(car)} description={car.blurb ?? `${carName(car)} in ${car.colour.toLowerCase()}, available at BMS Carz, Kharghar.`}>
  <section class="detail">
    <a href="/collection/" class="back">← The collection</a>
    <div class="top">
      <div>
        <div class="eyebrow">{[car.year, car.make].filter(Boolean).join(' · ')}</div>
        <h1 class="title">
          <span class="mask"><span data-line data-hero-reveal>{car.model}</span></span>
        </h1>
      </div>
      <div class="price">
        <div class="price__amount">{money(car)}</div>
        {monthly && <div class="price__emi">Finance from {monthly} / month</div>}
      </div>
    </div>

    <div class="body">
      <div class="viewer" data-reveal style={`width: min(100%, calc(78vh * ${(pw / ph).toFixed(4)}))`}>
        <div class="viewer__track" id="viewer-track" style={`aspect-ratio: ${pw} / ${ph}`}>
          {shots.map((src, i) => (
            <div class="viewer__slide">
              <img src={src} alt={`${carName(car)}, photo ${i + 1} of ${shots.length}`} width={pw} height={ph}
                loading="eager" decoding="async" fetchpriority={i === 0 ? 'high' : 'low'} />
            </div>
          ))}
        </div>
        <button type="button" class="viewer__nav viewer__nav--prev" id="viewer-prev" aria-label="Previous photo">‹</button>
        <button type="button" class="viewer__nav viewer__nav--next" id="viewer-next" aria-label="Next photo">›</button>
        <div class="viewer__count label" id="viewer-count">1 / {shots.length}</div>
        <div class="thumbs" id="viewer-thumbs">
          {shots.map((src, i) => (
            <button type="button" class="thumb" aria-label={`Show photo ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>
              <img src={src} alt="" loading="eager" decoding="async" fetchpriority="low" />
            </button>
          ))}
        </div>
      </div>

      <div class="info">
        {car.blurb && <p class="blurb" data-reveal>{car.blurb}</p>}
        <dl class="specs" data-reveal>
          {specs.map(([k, v]) => (
            <div class="spec">
              <dt class="label">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
        <aside class="panel" data-reveal>
          <div class="eyebrow">Enquire</div>
          <a href={`/contact/?car=${car.id}`} class="btn btn--solid panel__btn">Book a test drive</a>
          <a href="tel:+917947137079" class="btn btn--line panel__btn panel__btn--alt">Call the showroom</a>
        </aside>
      </div>
    </div>

      {related.length > 0 && (
        <div class="related">
          <div class="related__head" data-reveal>
            <h2 class="related__title">You may also consider</h2>
            <a href="/collection/" class="related__all">View all</a>
          </div>
          <div class="related__grid">
            {related.map((c, i) => <CarCard car={c} index={i} variant="related" />)}
          </div>
        </div>
      )}
  </section>
</Base>

<style>
  .detail { padding: 150px var(--gutter) 140px; }
  .back { display: inline-block; font-size: 10px; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: rgba(244, 245, 247,.6); transition: color .4s; }
  .back:hover { color: var(--ink); }
  .top { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-top: 32px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .top .eyebrow { letter-spacing: .34em; }
  .title { margin: 14px 0 0; font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-weight: 400; font-size: clamp(30px, 5vw, 80px); line-height: .98; overflow-wrap: break-word; }
  .price { text-align: right; }
  .price__amount { font-family: var(--display); font-stretch: 125%; font-weight: 400; font-size: clamp(20px, 2.2vw, 32px); }
  .price__emi { margin-top: 6px; font-size: 11px; letter-spacing: .14em; color: rgba(244, 245, 247,.55); }
  @media (max-width: 600px) { .price { text-align: left; } }

  .body { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); margin-top: 48px; align-items: start; }
  @media (max-width: 900px) { .body { grid-template-columns: 1fr; } }

  .viewer { position: relative; }
  .viewer__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    overscroll-behavior-x: contain; background: var(--surface);
  }
  .viewer__track::-webkit-scrollbar { display: none; }
  /* snap-stop: a fast swipe still moves just one photo (iOS otherwise flings past several). */
  .viewer__slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; }
  /* The frame matches the photo shape; contain is a safety net for any odd one out. */
  .viewer__slide img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .viewer__nav {
    position: absolute; top: calc(50% - 40px); width: 48px; height: 48px; border: 1px solid rgba(244, 245, 247, .24);
    background: rgba(0, 0, 0, .55); color: var(--ink); font-size: 26px; line-height: 1; cursor: pointer; transition: border-color .3s, opacity .3s;
  }
  .viewer__nav:hover { border-color: var(--ink); }
  .viewer__nav:disabled { opacity: 0; pointer-events: none; }
  .viewer__nav--prev { left: 14px; }
  .viewer__nav--next { right: 14px; }
  @media (pointer: coarse) { .viewer__nav { display: none; } }
  .viewer__count { margin-top: 14px; }
  .thumbs { display: flex; gap: 8px; margin-top: 14px; overflow-x: auto; scrollbar-width: none; }
  .thumbs::-webkit-scrollbar { display: none; }
  .thumb { flex: 0 0 64px; height: 80px; padding: 0; border: 1px solid transparent; background: var(--surface); cursor: pointer; opacity: .5; transition: opacity .3s, border-color .3s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .thumb:hover { opacity: .85; }
  .thumb[aria-current='true'] { opacity: 1; border-color: var(--ink); }

  .blurb { margin: 0 0 40px; font-weight: 300; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.5; text-wrap: pretty; }
  .specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0 36px; margin: 0; }
  .spec { padding: 20px 0; border-top: 1px solid var(--line); }
  .spec .label { letter-spacing: .28em; }
  .spec dd { margin: 10px 0 0; font-size: 16px; font-weight: 300; }

  .panel { margin-top: 40px; padding: 36px; border: 1px solid rgba(244, 245, 247,.12); background: #000; }
  .panel .eyebrow { letter-spacing: .34em; }
  .panel__btn { display: block; margin-top: 28px; padding: 18px; }
  .panel__btn--alt { margin-top: 12px; border-color: rgba(244, 245, 247,.24); }
  @media (max-width: 600px) { .panel { padding: 28px 22px; } }

  .related { margin-top: 140px; }
  .related__head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .related__title { margin: 0; font-family: var(--display); font-stretch: 125%; text-transform: uppercase; font-weight: 400; font-size: 28px; }
  .related__all { font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; color: rgba(244, 245, 247,.65); white-space: nowrap; }
  .related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: clamp(20px, 2.4vw, 36px); margin-top: 40px; }
  @media (max-width: 600px) {
    .detail { padding-top: 104px; padding-bottom: 96px; }
    .top { margin-top: 22px; padding-bottom: 24px; }
    .body { margin-top: 28px; }
    .related { margin-top: 88px; }
    .related__title { font-size: 22px; }
    .related__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
    .related__grid > :global(:nth-child(n + 3)) { display: none; }
  }
</style>

<script>
  const track = document.getElementById('viewer-track')!;
  const prev = document.getElementById('viewer-prev') as HTMLButtonElement;
  const next = document.getElementById('viewer-next') as HTMLButtonElement;
  const count = document.getElementById('viewer-count')!;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('#viewer-thumbs .thumb')];
  const total = thumbs.length;

  const current = () => Math.round(track.scrollLeft / track.clientWidth);
  const go = (i: number) => track.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * track.clientWidth, behavior: 'smooth' });

  function update() {
    const i = current();
    count.textContent = `${i + 1} / ${total}`;
    prev.disabled = i <= 0;
    next.disabled = i >= total - 1;
    thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    // Keep the active thumbnail in view without scrolling the page itself.
    const t = thumbs[i], strip = t?.parentElement;
    if (t && strip) strip.scrollTo({ left: t.offsetLeft - strip.offsetLeft - (strip.clientWidth - t.clientWidth) / 2 });
  }

  track.addEventListener('scroll', update, { passive: true });
  prev.addEventListener('click', () => go(current() - 1));
  next.addEventListener('click', () => go(current() + 1));
  thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
  track.tabIndex = 0;
  track.setAttribute('aria-label', 'Photos');
  track.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
  });
  update();
</script>
